# Copy to .env and adjust. All values are optional in development.

# Embedded Postgres (PGlite) data directory, or a real server: postgres://user:pass@host:5432/db
DATABASE_URL=./.data/pglite
UPLOAD_DIR=./.data/uploads
HOST=127.0.0.1
PORT=3001
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:5173
# Seeded admin. In development, requests without a session act as this user (see AUTH_DEV_BYPASS)
DEV_USER_EMAIL=admin@trading.local
# Public address of the web app (auth origin checks, links in e-mails)
PUBLIC_URL=http://localhost:5173
# At least 32 random characters in production, e.g. `openssl rand -base64 48`
AUTH_SECRET=
# Registration: invite (code from an admin), open or closed
REGISTRATION=invite
# Development only: without a session act as DEV_USER_EMAIL. Ignored in production
AUTH_DEV_BYPASS=true
# Sender of e-mails; until a provider is configured, e-mails go to the log
MAIL_FROM=Dziennik tradera <no-reply@localhost>
# Measure the CFD/futures difference every N hours (0 = off)
BASIS_INTERVAL_HOURS=4
# Fetch the Forex Factory calendar every N hours (0 = off)
CALENDAR_INTERVAL_HOURS=2

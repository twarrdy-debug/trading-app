# Copy to .env and adjust. All values are optional in development.

# Embedded Postgres (PGlite) data directory, or a real server: postgres://user:pass@host:5432/db
DATABASE_URL=./.data/pglite
UPLOAD_DIR=./.data/uploads
HOST=127.0.0.1
PORT=3001
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:5173
# Until login exists, every request acts as this user (created automatically in development)
DEV_USER_EMAIL=admin@trading.local
# Measure the CFD/futures difference every N hours (0 = off)
BASIS_INTERVAL_HOURS=4
# Fetch the Forex Factory calendar every N hours (0 = off)
CALENDAR_INTERVAL_HOURS=2

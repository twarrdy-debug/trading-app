# Production settings for docker-compose.yml: copy to .env in the repository root and fill in.
#   cp deploy/docker/env.example .env && chmod 600 .env
# DATABASE_URL, HOST, PORT and UPLOAD_DIR are set by docker-compose.yml.

# Database password (any long random string): openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# The address people open (Cloudflare Tunnel public hostname). Used for login checks and e-mail links.
PUBLIC_URL=https://twardy.it
CORS_ORIGIN=https://twardy.it

# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME

# invite = sign-up only with a code from the admin; open; closed.
REGISTRATION=invite

# The first admin (created on the first start while there is no admin). Then set its password:
#   docker compose exec api npm run user:login -- --user you@example.com --password '…'
DEV_USER_EMAIL=you@example.com

# E-mail through Resend (domain twardy.it verified there). Without SMTP_URL e-mails go to the log
# (docker compose logs api).
MAIL_FROM=Dziennik tradera <noreply@twardy.it>
SMTP_URL=smtps://resend:re_CHANGE_ME@smtp.resend.com:465

# Background data (defaults shown).
NEWS_INTERVAL_SECONDS=60
CALENDAR_INTERVAL_HOURS=2
BASIS_INTERVAL_HOURS=4

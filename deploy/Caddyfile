# Caddy in the app's LXC. Cloudflare Tunnel terminates HTTPS and forwards plain HTTP here.
# Same routing as the Vite dev server: /api/* goes to the API without the prefix, /files/* too,
# and everything else is the built web app (client-side routes fall back to index.html).
:8080 {
	# The API: sessions, data, the live news stream (Caddy flushes text/event-stream right away).
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Screenshots.
	handle /files/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /opt/trading-app/apps/web/dist
		encode zstd gzip
		# Hashed assets never change; index.html must always be fresh after an update.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/trading-app.log
	}
}
